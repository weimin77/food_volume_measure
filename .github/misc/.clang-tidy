---
Checks: >
  -*,
  # Generic
  bugprone-*,
  performance-*,
  # Numeric-algorithm noise: domain constants (0.5 cell-centre offset, 6
  # quadratic coefficients, 8 direction bins), size_t -> double casts, and
  # internal helpers with adjacent same-type parameters would all be flagged
  # without improving correctness. Keep bugprone-*/performance-* for the real
  # static analysis; drop the three below.
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cppcoreguidelines-avoid-magic-numbers,
  # CPP specific
  cppcoreguidelines-macro-usage

CheckOptions:
  - key: HeaderFileExtensions
    value: ".h,.hpp"
  - key: cppcoreguidelines-avoid-magic-numbers.CheckStrings
    value: '0'
WarningsAsErrors: '*'
# Anchored to repo paths only: third-party headers must not be flagged.
# Invoke clang-tidy with relative paths (e.g. `clang-tidy src/x.cpp`) so that
# repo headers resolve as `include/...`; apt-installed deps are system headers.
HeaderFilterRegex: "^(include|src)/"
